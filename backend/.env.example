PORT=5000
NODE_ENV=development
OPENAI_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/impactone_dev?schema=public
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/impactone_test?schema=public
# Phase PLATFORM-HARDENING-002 — set this to enable X-Admin-Api-Key
# protection on admin-only routes. Leave empty for local dev (matches
# every existing environment's current, unprotected behavior).
ADMIN_API_KEY=
# Phase REDIS-CACHE-001 — set this to enable the real provider cache.
# Leave empty for local dev (matches every existing environment's
# current, uncached behavior — the cache gracefully no-ops without it).
REDIS_URL=
REDIS_CACHE_DEFAULT_TTL_MS=300000
# Phase COMMERCIAL-MVP-001 — Commercial Infrastructure. Set a real,
# random secret in every real deployment (the code fallback is an
# insecure, disclosed dev/test-only default).
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
# "manual" (default) never calls out to any real payment vendor. Set to
# "stripe" plus the two keys below to enable real Stripe billing.
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
