PORT=5000
NODE_ENV=development
OPENAI_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
NASA_API_KEY=
SEC_EDGAR_USER_AGENT=
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/impactone_dev?schema=public
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/impactone_test?schema=public
# Phase PLATFORM-HARDENING-002 — set this to enable X-Admin-Api-Key
# protection on admin-only routes. Leave empty for local dev (matches
# every existing environment's current, unprotected behavior).
ADMIN_API_KEY=
# Phase REDIS-CACHE-001 — set this to enable the real provider cache.
# Leave empty for local dev (matches every existing environment's
# current, uncached behavior — the cache gracefully no-ops without it).
REDIS_URL=
REDIS_CACHE_DEFAULT_TTL_MS=300000
# Phase COMMERCIAL-MVP-001 — Commercial Infrastructure. Set a real,
# random secret in every real deployment (the code fallback is an
# insecure, disclosed dev/test-only default).
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
# "manual" (default) never calls out to any real payment vendor. Set to
# "stripe" plus the two keys below to enable real Stripe billing.
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Phase PRODUCTION-DEPLOYMENT-001 — comma-separated real origins to lock
# down CORS in production. Leave empty for local dev (matches today's
# allow-all behavior).
CORS_ALLOWED_ORIGINS=
# How long graceful shutdown waits (ms) for in-flight requests before
# forcing an exit.
SHUTDOWN_TIMEOUT_MS=10000
# Agent Scheduler / Observability / Redis-cache tuning knobs — all
# optional, all have safe defaults (see schedulerConfig.js /
# agentExecutionLog.js / requestFailureLog.js / providerCacheConfig.js).
AGENT_SCHEDULER_CONCURRENCY=
AGENT_SCHEDULER_TIMEOUT_MS=
AGENT_SCHEDULER_MAX_RETRIES=
AGENT_SCHEDULER_BASE_DELAY_MS=
AGENT_SCHEDULER_MAX_DELAY_MS=
AGENT_SCHEDULER_AGING_FACTOR_PER_MS=
AGENT_SCHEDULER_HEALTH_CACHE_TTL_MS=
AGENT_OBSERVABILITY_MAX_RECORDS=
AGENT_OBSERVABILITY_FAILURE_LOG_MAX_RECORDS=
REDIS_CACHE_PRICE_HISTORY_TTL_MS=
# Options Flow vendor gate — optional, honestly reports unconfigured
# until a real vendor key is set.
OPTIONS_FLOW_PROVIDER_API_KEY=
