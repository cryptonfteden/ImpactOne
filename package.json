{
  "name": "impactone",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start:all": "concurrently \"npm run server\" \"npm run client:5174\"",
    "server": "node backend/server.js",
    "client": "cd frontend && npm run dev",
    "client:5174": "cd frontend && npm run dev -- --host 127.0.0.1 --port 5174",
    "build": "cd frontend && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:deploy:test": "node backend/prisma/deployTestDb.js",
    "test:backend": "node --test --test-concurrency=1 backend/**/*.test.js",
    "test:frontend": "cd frontend && npm run test",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true
  }
}
