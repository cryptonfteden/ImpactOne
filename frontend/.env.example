VITE_API_BASE_URL=http://localhost:5000/api
# "legacy" (default) = existing localStorage-driven paper portfolio.
# "api" = preview the new server-owned Portfolio Engine (Sprint 14).
VITE_PORTFOLIO_ENGINE=legacy
# Reveals internal-only diagnostics nav items (Intelligence Console,
# Health Dashboard, Admin Dashboard, AI Performance Dashboard, NOVA
# Showcase). Never set "true" in a real production build.
VITE_DEV_CONSOLE=
